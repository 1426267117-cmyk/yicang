# ERP 独立 Shopify 只读凭证。不要复用 MUKU 看板凭证，也不要提交真实值。
# Partner 客户店铺使用 OAuth；CLIENT_ID/CLIENT_SECRET 只标识 ERP 独立应用，访问令牌会加密存入 ERP D1。
# 兼容已有商家后台应用的 ADMIN_ACCESS_TOKEN，但不要复制其他系统或看板的 Token。
# 开发期可临时开启无访问名单模式；上线前必须改为 false，并配置公司访问名单。
# 此开关只影响 ERP 应用内访问，不会放开 Sites 项目的源码发布权限。
ERP_DEV_OPEN_ACCESS=false

# 正式模式下第一位精确邮箱是 bootstrap owner；必须先由该账号初始化管理员。
# 其余精确邮箱及域名账号在 owner 初始化后加入，顺序不要随意调整。
ERP_ALLOWED_EMAILS=
ERP_ALLOWED_EMAIL_DOMAINS=
# AWS 员工飞书登录。权限由 ERP 团队权限管理。使用独立的飞书登录应用和会话密钥。
ERP_FEISHU_LOGIN_ENABLED=false
ERP_FEISHU_LOGIN_REQUIRED=false
ERP_FEISHU_LOGIN_APP_ID=
ERP_FEISHU_LOGIN_APP_SECRET=
ERP_FEISHU_LOGIN_TENANT_KEY=
ERP_FEISHU_LOGIN_SESSION_SECRET=
# 32 字节随机值的 Base64，仅作为 Sites Secret 配置，禁止提交真实值。
ERP_CONNECTOR_CREDENTIALS_KEY=
# 至少 32 个随机字符，供后台调度调用 webhook 补偿、Shopify 对账和 MUKU 刷新，禁止提交真实值。
ERP_INTERNAL_JOB_TOKEN=
# Sites MCP 写工具的已验证邮箱白名单（逗号分隔，非秘密配置）。未配置时一律拒绝自动刷新。
ERP_AUTOMATION_ALLOWED_EMAILS=
# 只有 Sites MCP 托管任务已实际保存并验证后才设为 true；该模式不要求内部任务 Token。
ERP_SITES_PROCUREMENT_SCHEDULE_CONFIGURED=false
# 只有外部调度器已实际配置并验证后才设为 true；端点存在不等于定时任务已运行。
ERP_SHOPIFY_RECONCILE_SCHEDULE_CONFIGURED=false

# Amazon SP-API 只读订单。四店需各自提供授权 Refresh Token 及该店已独立核实的一笔订单号。
# 工作区仅读取部署者明确绑定的租户。个人信息、订单回传和库存写回未启用。
ERP_AMAZON_ORDERS_TENANT_ID=
ERP_AMAZON_CLIENT_ID=
ERP_AMAZON_CLIENT_SECRET=
ERP_AMAZON_RECONCILE_ENABLED=false
ERP_AMAZON_SENYU_SELLER_ID=
ERP_AMAZON_SENYU_MARKETPLACE_ID=
ERP_AMAZON_SENYU_VERIFY_ORDER_ID=
ERP_AMAZON_SENYU_REFRESH_TOKEN=
ERP_AMAZON_KAGUYASU_SELLER_ID=
ERP_AMAZON_KAGUYASU_MARKETPLACE_ID=
ERP_AMAZON_KAGUYASU_VERIFY_ORDER_ID=
ERP_AMAZON_KAGUYASU_REFRESH_TOKEN=
ERP_AMAZON_ZHONGCHENG_SELLER_ID=
ERP_AMAZON_ZHONGCHENG_MARKETPLACE_ID=
ERP_AMAZON_ZHONGCHENG_VERIFY_ORDER_ID=
ERP_AMAZON_ZHONGCHENG_REFRESH_TOKEN=
ERP_AMAZON_GENJI_SELLER_ID=
ERP_AMAZON_GENJI_MARKETPLACE_ID=
ERP_AMAZON_GENJI_VERIFY_ORDER_ID=
ERP_AMAZON_GENJI_REFRESH_TOKEN=

# 飞书导出用于期初建账和管理员补录。历史定时通道只在明确设置为 continuous 后启用。
ERP_FEISHU_MODE=opening

# MUKU 数据看板只读出口。API Key 只能配置为后端 Secret，禁止暴露到前端。
MUKU_DASHBOARD_BASE_URL=
MUKU_DASHBOARD_API_KEY=
# 采购安全门默认要求库存源快照和 ERP 成功同步都不超过 30 分钟。
MUKU_FRESHNESS_MAX_AGE_MINUTES=30
# 采购计划使用的仓库库存行源时间上限；默认 48 小时，旧源重导不会解锁采购。
MUKU_INVENTORY_SOURCE_MAX_AGE_MINUTES=2880
# 官方订单最后成功同步上限；LOCAL QA 来源永远不通过真实采购门。
ERP_ORDER_SYNC_MAX_AGE_MINUTES=30
# 页面后台刷新及内部任务入口的最短尝试间隔，防止重复拉取。
MUKU_AUTO_REFRESH_MIN_INTERVAL_MINUTES=10
# 只有外部调度器已实际配置并验证后才设为 true；页面访问不算持续调度。
ERP_MUKU_EXTERNAL_SCHEDULE_CONFIGURED=false
# 仅本地开发可选：固定 Vite loopback 出口；部署环境必须留空。
# 例如：http://127.0.0.1:3000/__muku-local-egress/v1/export
MUKU_LOCAL_EGRESS_URL=

# 单店设为 true 后，OAuth 会在 read_orders 外加商品及库存只读权限。已授权店铺需重新授权。
# INITIAL_BACKFILL_ENABLED 单店设为 true 后，定时任务会为尚无同步水位的 OAuth 店铺回补最近 7 天。
# ACCEPTED_DOMAINS 可选，填写用逗号分隔的同店铺备用 myshopify.com 域名（不含协议和路径）。
SHOPIFY_ZIMASYA_SHOP_DOMAIN=
SHOPIFY_ZIMASYA_ACCEPTED_DOMAINS=
SHOPIFY_ZIMASYA_ADMIN_ACCESS_TOKEN=
SHOPIFY_ZIMASYA_CLIENT_ID=
SHOPIFY_ZIMASYA_CLIENT_SECRET=
SHOPIFY_ZIMASYA_CATALOG_READ_ENABLED=false
SHOPIFY_ZIMASYA_INITIAL_BACKFILL_ENABLED=false

SHOPIFY_KAGUYASU_SHOP_DOMAIN=
SHOPIFY_KAGUYASU_ACCEPTED_DOMAINS=
SHOPIFY_KAGUYASU_ADMIN_ACCESS_TOKEN=
SHOPIFY_KAGUYASU_CLIENT_ID=
SHOPIFY_KAGUYASU_CLIENT_SECRET=
SHOPIFY_KAGUYASU_CATALOG_READ_ENABLED=false
SHOPIFY_KAGUYASU_INITIAL_BACKFILL_ENABLED=false

SHOPIFY_ANZ_SHOP_DOMAIN=
SHOPIFY_ANZ_ACCEPTED_DOMAINS=
SHOPIFY_ANZ_ADMIN_ACCESS_TOKEN=
SHOPIFY_ANZ_CLIENT_ID=
SHOPIFY_ANZ_CLIENT_SECRET=
SHOPIFY_ANZ_CATALOG_READ_ENABLED=false
SHOPIFY_ANZ_INITIAL_BACKFILL_ENABLED=false

SHOPIFY_BIZFURNIZ_SHOP_DOMAIN=
SHOPIFY_BIZFURNIZ_ACCEPTED_DOMAINS=
SHOPIFY_BIZFURNIZ_ADMIN_ACCESS_TOKEN=
SHOPIFY_BIZFURNIZ_CLIENT_ID=
SHOPIFY_BIZFURNIZ_CLIENT_SECRET=
SHOPIFY_BIZFURNIZ_CATALOG_READ_ENABLED=false
SHOPIFY_BIZFURNIZ_INITIAL_BACKFILL_ENABLED=false
