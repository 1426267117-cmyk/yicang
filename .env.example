# ERP 独立 Shopify 只读凭证。不要复用 MUKU 看板凭证，也不要提交真实值。
# Partner 客户店铺使用 OAuth；CLIENT_ID/CLIENT_SECRET 只标识 ERP 独立应用，访问令牌会加密存入 ERP D1。
# 兼容已有商家后台应用的 ADMIN_ACCESS_TOKEN，但不要复制其他系统或看板的 Token。
# 接入真实订单前必须至少配置一个公司访问名单；多个值用逗号分隔。

ERP_ALLOWED_EMAILS=
ERP_ALLOWED_EMAIL_DOMAINS=
# 32 字节随机值的 Base64，仅作为 Sites Secret 配置，禁止提交真实值。
ERP_CONNECTOR_CREDENTIALS_KEY=

SHOPIFY_ZIMASYA_SHOP_DOMAIN=346c85.myshopify.com
SHOPIFY_ZIMASYA_ADMIN_ACCESS_TOKEN=
SHOPIFY_ZIMASYA_CLIENT_ID=
SHOPIFY_ZIMASYA_CLIENT_SECRET=

SHOPIFY_KAGUYASU_SHOP_DOMAIN=officebaseca.myshopify.com
SHOPIFY_KAGUYASU_ADMIN_ACCESS_TOKEN=
SHOPIFY_KAGUYASU_CLIENT_ID=
SHOPIFY_KAGUYASU_CLIENT_SECRET=

SHOPIFY_ANZ_SHOP_DOMAIN=anzhap.myshopify.com
SHOPIFY_ANZ_ADMIN_ACCESS_TOKEN=
SHOPIFY_ANZ_CLIENT_ID=
SHOPIFY_ANZ_CLIENT_SECRET=

SHOPIFY_BIZFURNIZ_SHOP_DOMAIN=z6w01w-xs.myshopify.com
SHOPIFY_BIZFURNIZ_ADMIN_ACCESS_TOKEN=
SHOPIFY_BIZFURNIZ_CLIENT_ID=
